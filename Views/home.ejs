<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <%- include('./partials/nav.ejs') %> <% if(currentUser){ %>
    <h2>Welcome <%=currentUser.full_name%>!</h2>
    <div class="new__message">
      <a href="/new-message">New Message</a>
    </div>
    <%}%>
    <section class="messages">
      <% if(currentUser){%> <% messages.forEach(function(message){%>
      <div class="message">
        <h3 class="message_title"><%=message.title%></h3>
        <h4 class="message_content"><%=message.message%></h4>
        <% if(currentUser.membership){ %>
        <h5 class="message_author"><%=message.author%></h5>
        <h6 class="message_date"><%=message.date%></h6>
        <% if(currentUser.is_admin){ %>
        <a href="/delete-message/<%=message.id%>"><button>Delete</button></a>
        <%}%>
      </div>
      <%}})%> <%}else{%> <% messages.forEach(function(message){%>
      <div class="message">
        <h3><%=message.title%></h3>
        <h4><%=message.message%></h4>
      </div>
      <%})%> <%}%>
    </section>
  </body>
</html>

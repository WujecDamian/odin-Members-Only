<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CLUB+</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <%- include('./partials/nav.ejs') %>
    <h2>GET CLUB+ ACCESS (Redeem your special code)</h2>
    <form action="/club" method="post">
      <input type="hidden" name="currentUserId" value="<%=currentUser.id%>" />
      <label for="code">*SECRET CODE*</label>
      <input type="password" name="code" id="code" required />
      <input type="submit" value=" REDEEM CODE" />
    </form>
  </body>
</html>
